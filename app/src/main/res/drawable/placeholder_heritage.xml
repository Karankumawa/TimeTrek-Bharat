    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="400"
    android:viewportHeight="250">

    <!-- Royal Heritage Gradient Background -->
    <path android:pathData="M0,0h400v250h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="400"
                android:endY="250"
                android:type="linear">
                <item android:color="#2A1B3D" android:offset="0.0" />
                <item android:color="#4A148C" android:offset="0.5" />
                <item android:color="#D84315" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Wheel Accent Ring -->
    <path
        android:pathData="M200,125 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0"
        android:strokeColor="#30FFFFFF"
        android:strokeWidth="2" />

    <!-- Center Glowing Diamond Sparkle -->
    <path
        android:pathData="M200,105 L205,120 L220,125 L205,130 L200,145 L195,130 L180,125 L195,120 Z"
        android:fillColor="#80FFFFFF" />
</vector>
